{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[0-9]{5}$/)",
        ".write": "auth != null && $code.matches(/^[0-9]{5}$/) && ((!data.exists() && newData.exists() && newData.child('owner').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length <= 70 && newData.child('chatEnabled').val() === true) || (data.exists() && data.child('owner').val() === auth.uid))",
        "students": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().exists() && newData.exists() && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 50",
            ".validate": "newData.hasChildren(['name'])"
          }
        },
        "messages": {
          "$messageId": {
            ".write": "auth != null && !data.exists() && newData.exists() && newData.child('uid').val() === auth.uid && (root.child('rooms').child($code).child('owner').val() === auth.uid || (root.child('rooms').child($code).child('students').child(auth.uid).exists() && root.child('rooms').child($code).child('chatEnabled').val() === true))",
            ".validate": "newData.hasChildren(['uid','text','createdAt']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500 && newData.child('createdAt').isNumber()"
          }
        },
        "chatEnabled": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
        "profile": {
          ".validate": "newData.hasChildren(['name','role']) && newData.child('name').isString() && newData.child('name').val().length <= 60 && (newData.child('role').val() === 'student' || newData.child('role').val() === 'teacher')"
        },
        "progress": {
          ".validate": "newData.isString() && newData.val().length <= 100000"
        },
        "$other": {
          ".validate": "false"
        },
        "classes": {
          "$cid": {
            ".validate": "newData.isBoolean()"
          }
        },
        "fcm": {
          "$tok": {
            ".validate": "newData.val() === 'ru' || newData.val() === 'uz'"
          }
        }
      }
    },
    "classCodes": {
      "$code": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous'",
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && !data.exists() && root.child('users/'+auth.uid+'/profile/role').val() === 'teacher' && root.child('teachersVerified/'+auth.uid).exists()",
        ".validate": "newData.isString() && newData.val().length <= 40"
      }
    },
    "classes": {
      "$cid": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && ((!data.exists() && newData.child('owner').val() === auth.uid && root.child('users/'+auth.uid+'/profile/role').val() === 'teacher' && root.child('teachersVerified/'+auth.uid).exists()) || data.child('owner').val() === auth.uid)",
        "name": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('classes/'+$cid+'/owner').val() === auth.uid || root.child('classes/'+$cid+'/members/'+auth.uid).exists())",
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60"
        },
        "owner": {
          ".validate": "newData.isString()"
        },
        "code": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('classes/'+$cid+'/owner').val() === auth.uid)",
          ".validate": "newData.isString() && newData.val().length === 6"
        },
        "members": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('classes/'+$cid+'/owner').val() === auth.uid)",
          "$uid": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && root.child('classes/'+$cid+'/owner').exists() && ($uid === auth.uid || root.child('classes/'+$cid+'/owner').val() === auth.uid)",
            ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 60"
          }
        }
      }
    },
    "homework": {
      "$cid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('classes/'+$cid+'/owner').val() === auth.uid || root.child('classes/'+$cid+'/members/'+auth.uid).exists())",
        "$hid": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && root.child('classes/'+$cid+'/owner').val() === auth.uid",
          ".validate": "newData.hasChildren(['title']) && newData.child('title').isString() && newData.child('title').val().length <= 120",
          "text": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          },
          "due": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "title": {
            ".validate": "true"
          }
        }
      }
    },
    "submissions": {
      "$cid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('classes/'+$cid+'/owner').val() === auth.uid)",
        "$hid": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && root.child('classes/'+$cid+'/owner').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid",
            ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid && root.child('classes/'+$cid+'/members/'+auth.uid).exists() && root.child('homework/'+$cid+'/'+$hid).exists()",
            ".validate": "newData.hasChildren(['text','at','name'])",
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 2000"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "at": {
              ".validate": "newData.isNumber()"
            }
          }
        }
      }
    },
    "teachers": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous'",
      "$uid": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid && root.child('users/'+auth.uid+'/profile/role').val() === 'teacher'",
        ".validate": "newData.hasChildren(['name','surname','subject','g1','g2'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "surname": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "subject": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "g1": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 11"
        },
        "g2": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 11"
        },
        "$o": {
          ".validate": "false"
        }
      }
    },
    "chats": {
      "$cid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (data.child('t').val() === auth.uid || data.child('s').val() === auth.uid)",
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && !data.exists() && newData.child('s').val() === auth.uid && $cid === newData.child('t').val() + '_' + auth.uid && root.child('teachers/'+newData.child('t').val()).exists() && root.child('users/'+auth.uid+'/profile/role').val() === 'student' && root.child('teachersVerified/'+newData.child('t').val()).exists()",
        ".validate": "newData.hasChildren(['t','s','tName','sName'])",
        "t": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "s": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "tName": {
          ".validate": "newData.isString() && newData.val().length <= 61"
        },
        "sName": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "subject": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "last": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('chats/'+$cid+'/t').val() === auth.uid || root.child('chats/'+$cid+'/s').val() === auth.uid)",
          ".validate": "newData.hasChildren(['from','at','text'])"
        },
        "unread": {
          "$u": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('chats/'+$cid+'/t').val() === auth.uid || root.child('chats/'+$cid+'/s').val() === auth.uid)",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        },
        "read": {
          "$u": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $u && (root.child('chats/'+$cid+'/t').val() === auth.uid || root.child('chats/'+$cid+'/s').val() === auth.uid)",
            ".validate": "newData.isNumber()"
          }
        },
        "$o": {
          ".validate": "false"
        }
      }
    },
    "chatMsgs": {
      "$cid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('chats/'+$cid+'/t').val() === auth.uid || root.child('chats/'+$cid+'/s').val() === auth.uid)",
        ".indexOn": [
          "at"
        ],
        "$mid": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && !data.exists() && (root.child('chats/'+$cid+'/t').val() === auth.uid || root.child('chats/'+$cid+'/s').val() === auth.uid) && newData.child('from').val() === auth.uid",
          ".validate": "newData.hasChildren(['from','text','at']) && newData.child('text').isString() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 1000 && newData.child('at').isNumber()"
        }
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid",
        "$cid": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('chats/'+$cid+'/t').val() === auth.uid || root.child('chats/'+$cid+'/s').val() === auth.uid) && ($uid === root.child('chats/'+$cid+'/t').val() || $uid === root.child('chats/'+$cid+'/s').val())",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "teachersVerified": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous'",
      "$uid": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && root.child('admins/'+auth.uid).val() === true",
        ".validate": "newData.isBoolean()"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "tests": {
      "$cid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('classes/'+$cid+'/owner').val() === auth.uid || root.child('classes/'+$cid+'/members/'+auth.uid).exists())",
        "$tid": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && root.child('classes/'+$cid+'/owner').val() === auth.uid",
          ".validate": "newData.hasChildren(['title','qs']) && newData.child('title').isString() && newData.child('title').val().length <= 120 && newData.child('qs').isString() && newData.child('qs').val().length <= 20000"
        }
      }
    },
    "testResults": {
      "$cid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('classes/'+$cid+'/owner').val() === auth.uid)",
        "$tid": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && root.child('classes/'+$cid+'/owner').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid",
            ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid && root.child('classes/'+$cid+'/members/'+auth.uid).exists() && root.child('tests/'+$cid+'/'+$tid).exists()",
            ".validate": "newData.hasChildren(['score','total','name','at']) && newData.child('score').isNumber() && newData.child('total').isNumber() && newData.child('total').val() <= 30 && newData.child('score').val() >= 0 && newData.child('score').val() <= newData.child('total').val() && newData.child('name').isString() && newData.child('name').val().length <= 60"
          }
        }
      }
    },
    "roomIndex": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous'",
      "$code": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && $code.matches(/^[0-9]{5}$/) && ((newData.exists() && newData.child('owner').val() === auth.uid && root.child('rooms/'+$code+'/owner').val() === auth.uid && root.child('teachersVerified/'+auth.uid).exists()) || (!newData.exists() && (data.child('owner').val() === auth.uid || root.child('admins/'+auth.uid).val() === true)))",
        ".validate": "newData.hasChildren(['name','subject','grade','teacher','owner'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 70"
        },
        "subject": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "teacher": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
        },
        "owner": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
        },
        "grade": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 11"
        },
        "$o": {
          ".validate": "false"
        }
      }
    },
    "userIndex": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && root.child('admins/'+auth.uid).val() === true",
      "$uid": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name','role'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "role": {
          ".validate": "newData.val() === 'student' || newData.val() === 'teacher'"
        },
        "$o": {
          ".validate": "false"
        }
      }
    },
    "videos": {
      ".read": true,
      "$k": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('admins/'+auth.uid).val() === true || (root.child('teachersVerified/'+auth.uid).exists() && (!data.exists() || data.child('by').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['url','by','at']) && newData.child('url').isString() && newData.child('url').val().length <= 300 && newData.child('url').val().matches(/^https:\\/\\/(www\\.)?(youtube\\.com|youtu\\.be)\\/.+/) && newData.child('by').val() === auth.uid",
        "lang": {
          ".validate": "newData.val() === 'ru' || newData.val() === 'uz'"
        },
        "at": {
          ".validate": "newData.isNumber()"
        }
      }
    }
  }
}